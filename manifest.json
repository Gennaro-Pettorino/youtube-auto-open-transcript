{
  "manifest_version": 3,
  "name": "YouTube Auto Transcript",
  "version": "1.0",
  "description": "Automatically opens the transcript panel on YouTube videos",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ]
}
